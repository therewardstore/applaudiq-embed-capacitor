{
  "git": {
    "commitMessage": "chore: release ${version}",
    "tagName": "v${version}",
    "tagAnnotation": "Release ${version}",
    "requireCleanWorkingDir": true,
    "tag": false,
    "push": false
  },
  "npm": {
    "publish": false
  },
  "github": {
    "release": false
  },
  "hooks": {
    "before:init": ["pnpm run typecheck"],
    "after:bump": "pnpm run build"
  }
}
