# Add to repositories_frontend_rulesets.tf in github-terraform (branch fe-no-delete-dev-master),
# then `make plan` and `make apply`. A NEW ruleset: the existing protect-* rulesets stay as they are.
# No bypass actors. Stage it after agent-gates has reported once on this repo.
resource "github_repository_ruleset" "fe_agent_gates_applaudiq_embed_capacitor" {
  name        = "fe-agent-gates"
  repository  = github_repository.applaudiq_embed_capacitor.name
  target      = "branch"
  enforcement = "active"

  conditions {
    ref_name {
      include = ["~DEFAULT_BRANCH"]
      exclude = []
    }
  }

  rules {
    pull_request {
      require_code_owner_review = true
    }
    required_status_checks {
      strict_required_status_checks_policy = true
      do_not_enforce_on_create             = true
      required_check {
        context = "agent-gates"
      }
      required_check {
        context = "agent-gates-merged"
      }
    }
  }
}
