# One rule per repo script and per gate command; "allow" runs it without a prompt.
# Generated by friday from scripts/agent/agent.conf and the scripts it installed.
prefix_rule(pattern=["bash", "scripts/agent/doctor.sh"], decision="allow")
prefix_rule(pattern=["bash", "scripts/agent/drift-check.sh"], decision="allow")
prefix_rule(pattern=["bash", "scripts/agent/env-check.sh"], decision="allow")
prefix_rule(pattern=["bash", "scripts/agent/fingerprint.sh"], decision="allow")
prefix_rule(pattern=["bash", "scripts/agent/gates.sh"], decision="allow")
prefix_rule(pattern=["bash", "scripts/agent/guard-shell.sh"], decision="allow")
prefix_rule(pattern=["bash", "scripts/agent/prompt-check.sh"], decision="allow")
prefix_rule(pattern=["bash", "scripts/agent/qa-confirmed.sh"], decision="allow")
prefix_rule(pattern=["bash", "scripts/agent/scan-diff.sh"], decision="allow")
prefix_rule(pattern=["bash", "scripts/agent/session-check.sh"], decision="allow")
prefix_rule(pattern=["bash", "scripts/agent/ship.sh"], decision="allow")
prefix_rule(pattern=["bash", "scripts/agent/status.sh"], decision="allow")
prefix_rule(pattern=["bash", "scripts/agent/test-changed.sh"], decision="allow")
prefix_rule(pattern=["bash", "scripts/git/check-branch.sh"], decision="allow")
prefix_rule(pattern=["bash", "scripts/git/check-commit-msg.sh"], decision="allow")
prefix_rule(pattern=["bash", "scripts/git/check-commit-range.sh"], decision="allow")
prefix_rule(pattern=["bash", "scripts/git/check-docs-moved.sh"], decision="allow")
prefix_rule(pattern=["bash", "scripts/git/check-file-cap.sh"], decision="allow")
prefix_rule(pattern=["bash", "scripts/git/pr-title.sh"], decision="allow")
prefix_rule(pattern=["bash", "scripts/git/prepare-commit-msg.sh"], decision="allow")
prefix_rule(pattern=["pnpm", "typecheck"], decision="allow")
prefix_rule(pattern=["pnpm", "build"], decision="allow")
prefix_rule(pattern=["pnpm", "run", "audit:deps"], decision="allow")
