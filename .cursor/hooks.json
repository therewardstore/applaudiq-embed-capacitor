{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "bash scripts/agent/session-check.sh cursor full",
        "timeout": 30
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "bash scripts/agent/prompt-check.sh cursor",
        "timeout": 10
      }
    ],
    "beforeShellExecution": [
      {
        "command": "bash scripts/agent/guard-shell.sh cursor",
        "timeout": 10,
        "failClosed": true
      }
    ]
  }
}
